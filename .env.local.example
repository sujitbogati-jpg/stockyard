# Copy this file to .env.local for local testing, and enter the same
# values in Vercel under Project Settings -> Environment Variables.

# From Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# A shared password for your team. This is basic protection only -
# anyone with the link and password can use the app. Good enough for an
# internal tool; upgrade to Supabase Auth later if you need per-user logins.
NEXT_PUBLIC_APP_PASSWORD=change-this-password
